{
  "expo": {
    "name": "Nasreddins Simple Peek Client 2",
    "slug": "nasreddins-simple-peek-client2",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "nasreddinssimplepeekclient2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Diese App benötigt Kamerazugriff, um die LiveVideo-Sendeansichten anzuzeigen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006D77",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "de.nasreddin.simplepeekclient2"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Diese App benötigt Kamerazugriff, um die LiveVideo-Sendeansichten anzuzeigen."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006D77",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
